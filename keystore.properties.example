# RescueAuth production Android signing configuration — EXAMPLE ONLY.
#
# This file is a TEMPLATE and must NEVER contain a real secret. Copy it to a
# local `keystore.properties` (same directory) that is gitignored, and fill in
# the four fields with the values for the REAL production keystore you create
# offline (see docs/RELEASE_PROVISIONING.md §"Production signing key generation").
#
# The `storeFile` should be an ABSOLUTE path to a keystore located OUTSIDE the
# repository (e.g. in a trusted, backed-up location). Never commit the keystore
# or this file with real passwords.
#
# Alternatives to this file: set the environment variables
#   RESCUEAUTH_STORE_FILE / RESCUEAUTH_STORE_PASSWORD /
#   RESCUEAUTH_KEY_ALIAS / RESCUEAUTH_KEY_PASSWORD
# on the build machine / CI instead.

storeFile=/absolute/path/to/rescueauth-release.jks
storePassword=CHANGE_ME
keyAlias=rescueauth-v2
keyPassword=CHANGE_ME
