# ---------------------------------------------------------------------------
# RescueAuth (native Android) — root .gitignore
# ---------------------------------------------------------------------------

# Gradle / Android build outputs
.gradle/
.kotlin/
build/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# IntelliJ / IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS / editor
.DS_Store
*.swp
*.log

# ---------------------------------------------------------------------------
# Agent / IDE assistant project data. These directories hold session memory,
# daily work logs and transient automation state. They are NEVER committed —
# enforce it here so a blanket `git add .` cannot leak them in.
# ---------------------------------------------------------------------------
.workbuddy/
.codebuddy/

# ---------------------------------------------------------------------------
# RescueAuth production Android signing secrets (Release Provisioning Step 1).
# The production private key must live entirely OUTSIDE the repo. Only the
# `.example` template is committed. Developer Vault synthetic keystore
# fixtures are in-memory byte arrays in test sources and are unaffected.
# ---------------------------------------------------------------------------
/keystore.properties
*.jks
*.keystore
*.p12
*.pfx

# Firebase Test Lab CI: transient gate file generated at runtime on the CI
# workspace (never committed)
.cnb-gate.env

# Local web research cache
.firecrawl/

# Local design studies and rendered UI review output; source assets live in design/brand.
/design/banner-concepts/
/screenshots/
/design/brand/candidates/
/design/brand/revisions/
/design/brand/*-preview.*
/design/brand/*-options.*
/design/brand/*-check.json
/design/brand/vector-fit.json
/design/brand/validation.json

# Python developer-tool caches.
__pycache__/
*.py[cod]
